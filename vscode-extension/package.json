{
  "name": "svg-badge-outline",
  "displayName": "SVG Badge & Outline",
  "description": "Lab1 Phase 2 Part 1: marks .svg files with [] in the Explorer and shows the SVG element tree in the Outline view",
  "version": "0.1.0",
  "publisher": "lab1-svg-editor",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "package": "npm run compile && vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
