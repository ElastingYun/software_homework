{
  "name": "svg-editor-cli",
  "version": "0.8.7",
  "description": "Lab1 Phase 1: command-line SVG editor (TypeScript, OO, Command pattern)",
  "type": "module",
  "private": true,
  "bin": {
    "svg-editor": "dist/main.js"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run lint:deps && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
